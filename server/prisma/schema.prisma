// Source of truth for the schema. Keep docs/08-data-model.mdx in sync with this file
// whenever they diverge — see docs/08-data-model.mdx.

// Prisma 7: the connection URL lives in prisma.config.ts, not here. PrismaClient
// requires a driver adapter (@prisma/adapter-pg) at runtime — see src/db/prisma.ts.
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Session / verification tables (inherited from Auth.js; now written by the API) -----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Domain model — see docs/01-domain-model.mdx and docs/08-data-model.mdx ------------------

enum Role {
  MENTEE
  MENTOR
  ADMIN
}

enum WeeklyGoalKind {
  SESSIONS
  CHAPTERS
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum VariantAssignment {
  SELF_SELECT
  RANDOM
}

enum CourseCategory {
  TECH
  SOFT_SKILLS
}

enum CourseInstructorRole {
  COURSE_CREATOR
  SUBMISSION_EVALUATOR
}

enum EnrollStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  DROPPED
}

enum EnrollmentLifecycle {
  PENDING_ACCOUNT
  PAYMENT_REQUIRED
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

enum EnrollmentSource {
  DIRECT
  INVITE
  SELF
  PATHMENT
}

enum CoursePricingType {
  FREE
  PAID
}

enum OrganizationCourseRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum BlockType {
  QUIZ
  TEST
  MUST_READ
  OPEN_QUESTION
  CODE
  STEPS
  PROJECT_PREVIEW
  LEARNING_OBJECTIVES
  CHAPTER_RECAP
  PREDICT
  VIDEO
  VISUAL_WALKTHROUGH
  VISUAL_DIAGRAM
  ROADMAP
  AI_INTERVIEW
}

enum ResponseStatus {
  DRAFT
  SUBMITTED
  AUTO_GRADED
  PENDING_REVIEW
  REVIEWED
  NEEDS_REVISION
}

enum ReviewVerdict {
  APPROVED
  NEEDS_REVISION
}

enum HelpThreadStatus {
  OPEN
  RESOLVED
}

enum StudySessionStatus {
  RUNNING
  PAUSED
  ENDED
}

enum AiProvider {
  OPENROUTER
}

enum AiInterviewStatus {
  ACTIVE
  FINISHED
  ABANDONED
}

enum InstructorAccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          Role         @default(MENTEE)
  passwordHash  String?
  /// Base32 TOTP secret while MFA is set up. Null means MFA is off.
  totpSecret    String?      @db.VarChar(64)
  /// Set once the account confirmed a TOTP code; MFA is enforced from then on.
  totpEnabledAt DateTime?
  /// SHA-256 hashes of unused recovery codes. The plaintext is shown exactly once.
  totpRecoveryCodes String[] @default([])
  zipImportEnabled Boolean @default(false)
  /// Set by a platform admin to block sign-in; null means the account is active.
  suspendedAt   DateTime?
  suspensionNote String?      @db.VarChar(240)
  weeklyGoalKind WeeklyGoalKind?
  weeklyGoalTarget Int?
  weeklyGoalNote String? @db.VarChar(240)
  weeklyGoalReminderEnabled Boolean @default(false)
  weeklyGoalReminderSentOn DateTime? @db.Date
  celebratedStreakMilestones Int[] @default([])
  createdAt     DateTime     @default(now())
  accounts      Account[]
  sessions      Session[]
  profile       UserProfile?
  learnerProfile LearnerProfile?
  coursesOwned  Course[]     @relation("CourseMentor")
  courseMemberships CourseInstructor[]
  courseInstructorInvitesSent CourseInstructorInvite[] @relation("CourseInstructorInviteSender")
  enrollments   Enrollment[]
  responses     Response[]
  reviewsGiven          Review[]       @relation("Reviewer")
  invitesSent           Invite[]       @relation("InviteSender")
  helpThreadsAsked      HelpThread[]   @relation("HelpThreadsAsked")
  helpMessagesAuthored  HelpMessage[]  @relation("HelpMessagesAuthored")
  headingNotes          HeadingNote[]
  organizationCourseRequestsReviewed OrganizationCourseRequest[] @relation("OrgCourseRequestReviewer")
  instructorAccessRequest       InstructorAccessRequest?
  instructorAccessReviews       InstructorAccessRequest[] @relation("InstructorAccessReviewer")
  aiCredential                  AiCredential?
  aiInterviewSessions           AiInterviewSession[]
  appActivity                   UserAppActivity?
  appActivityDays               AppActivityDay[]
  notifications                 Notification[]
  notificationPreference        NotificationPreference?
  emailOutbox                   EmailOutbox[]
  studyReminders                StudyReminderLog[]
}

/// A learner's own AI provider key for AI interviews. Only the AES-256-GCM
/// ciphertext is stored (key from AI_KEY_ENCRYPTION_KEY, the user id as
/// associated data); the plaintext key never leaves the server.
model AiCredential {
  id         String     @id @default(cuid())
  userId     String     @unique
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   AiProvider @default(OPENROUTER)
  ciphertext String     @db.Text
  iv         String     @db.VarChar(32)
  authTag    String     @db.VarChar(32)
  lastFour   String     @db.VarChar(4)
  /// Model id chosen by the learner; null means the server default.
  model      String?    @db.VarChar(120)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  lastUsedAt DateTime?
}

/// One run of an AI_INTERVIEW block. The transcript and feedback are the
/// learner's own words plus the interviewer's questions; the rubric lives only
/// in Block.config and is never copied here.
model AiInterviewSession {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  blockId    String
  block      Block             @relation(fields: [blockId], references: [id], onDelete: Cascade)
  status     AiInterviewStatus @default(ACTIVE)
  /// Resume or project text the learner pasted, when the block asks for it.
  context    String?           @db.Text
  /// The "important work" box, when the block asks for a resume and work together.
  contextWork String?          @db.Text
  /// Ordered turns: [{ role: "interviewer" | "candidate", content, focus?, depth?, at }].
  transcript Json              @default("[]")
  /// Validated AiInterviewFeedback, set when the session finishes.
  feedback   Json?
  /// Answers the learner has given so far.
  turnCount  Int               @default(0)
  /// Model id used, kept so a mentor can see what produced the feedback.
  model      String?           @db.VarChar(120)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  finishedAt DateTime?

  @@index([userId, blockId, status])
  @@index([blockId])
}

model InstructorAccessRequest {
  id           String                        @id @default(cuid())
  userId       String                        @unique
  status       InstructorAccessRequestStatus @default(PENDING)
  message      String?                       @db.Text
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("InstructorAccessReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
}

model UserProfile {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  timezone  String   @default("UTC")
  skills    String[] @default([])
  updatedAt DateTime @updatedAt
}

model LearnerProfile {
  id          String       @id @default(cuid())
  email       String       @unique
  userId      String?      @unique
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  linkedAt    DateTime?
  createdAt   DateTime     @default(now())
  enrollments Enrollment[]
}

model Course {
  id             String       @id @default(cuid())
  slug           String       @unique
  title          String
  description    String?
  coverUrl       String?
  projectGoal    String? // "Build a multi-vendor marketplace"
  difficulty     String?
  estimatedHours Int?
  category       CourseCategory @default(TECH)
  status         CourseStatus @default(DRAFT)
  pricingType    CoursePricingType @default(FREE)
  priceCents     Int          @default(0)
  currency       String       @default("USD")
  sequential     Boolean      @default(true)
  familySlug     String? // course family in src/shared/lib/course-tracks.ts; null = no variants
  variantFamily  Json? // creator-defined variant catalog; null uses a built-in family
  availableVariantSlugs String[] @default([]) // empty means every family variant is available
  variantAssignment VariantAssignment @default(SELF_SELECT)
  activeReleaseId String? // latest approved content release; set atomically with publication
  repositorySourceHash String? // last repository package published by the backend release
  repositoryReleaseId String? // release active when that package was published
  releases       CourseRelease[]
  /// Quiz camera photos are opt-in per course and never required; quiz integrity signals are always on.
  integritySnapshots Boolean  @default(false)
  mentorId       String
  mentor         User         @relation("CourseMentor", fields: [mentorId], references: [id])
  instructors    CourseInstructor[]
  instructorInvites CourseInstructorInvite[]
  modules        Module[]
  importPreviews CourseImportPreview[]
  chapters       Chapter[]
  chapterDrafts  CourseChapterDraft[]
  enrollments    Enrollment[]
  organizationCourses OrganizationCourse[]
  organizationCourseRequests OrganizationCourseRequest[]
  invites        Invite[]
  helpThreads    HelpThread[]
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([mentorId, status])
}

model CourseInstructor {
  id        String               @id @default(cuid())
  courseId  String
  userId    String
  role      CourseInstructorRole
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  course    Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([userId, role])
}

model CourseInstructorInvite {
  id          String               @id @default(cuid())
  courseId    String
  email       String
  role        CourseInstructorRole
  token       String               @unique
  invitedById String
  acceptedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime             @default(now())
  course      Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  invitedBy   User                 @relation("CourseInstructorInviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([courseId, email, acceptedAt])
  @@index([email, expiresAt])
}

model Module {
  id       String    @id @default(cuid())
  courseId String
  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  contentKey String? // stable author key, independent of title, path and order
  title    String
  order    Int
  archivedAt DateTime?
  chapters Chapter[]

  @@unique([courseId, order])
  @@unique([courseId, contentKey])
}

enum ChapterReaderMode {
  DEFAULT
  QUIZ
}

model Chapter {
  id                String            @id @default(cuid())
  courseId          String
  course            Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId          String?
  module            Module?           @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  contentKey        String?           // stable author key, independent of title, path and module
  slug              String
  title             String
  summary           String?
  order             Int
  estimatedMinutes  Int?
  readerMode        ChapterReaderMode @default(DEFAULT)
  source            String            @db.Text // raw MDX (draft)
  compiled          String?           @db.Text // compiled MDX at publish
  publishedAt       DateTime?
  isMilestone       Boolean           @default(false)
  archivedAt        DateTime?
  blocks            Block[]
  progress          ChapterProgress[]
  helpThreads       HelpThread[]
  studySessions     StudySession[]
  headingNotes      HeadingNote[]
  integrityAttempts IntegrityAttempt[]
  releaseDraft CourseChapterDraft?

  @@unique([courseId, slug])
  @@unique([courseId, contentKey])
  @@index([courseId, order])
}

model CourseChapterDraft {
  chapterId String @id
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  courseId String
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  baseReleaseId String
  title String
  summary String?
  estimatedMinutes Int?
  readerMode ChapterReaderMode
  isMilestone Boolean
  source String @db.Text
  updatedAt DateTime @updatedAt

  @@index([courseId])
}

// Server-owned preview: clients approve an immutable, expiring update, never send a plan to apply.
model CourseImportPreview {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId      String
  fingerprint String
  plan        Json
  diff        Json
  expiresAt   DateTime
  appliedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([courseId, userId])
  @@index([expiresAt])
}

// Immutable, materialized curriculum. Each variant lists the chapter rows it uses;
// shared chapters may be referenced by several variants and releases.
model CourseRelease {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  number      Int
  content     Json
  sourceHash  String?
  createdAt   DateTime @default(now())
  enrollments Enrollment[]

  @@unique([courseId, number])
  @@unique([courseId, sourceHash])
}

model Block {
  id         String     @id // ULID authored into the MDX
  chapterId  String
  chapter    Chapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  type       BlockType
  order      Int
  version    Int        @default(1)
  required   Boolean    @default(true)
  blocking   Boolean    @default(false)
  points     Int        @default(1)
  config     Json // answers, rubric, tests — SERVER ONLY, never sent to the client
  sourceHash String? // hash of the block's MDX subtree; change detection bumps version (docs/02-content-authoring.mdx)
  tags       String[] // for weak-area reporting
  archivedAt DateTime?
  // Null for blocks that existed before this column. Progress uses it so a
  // block added after a learner finished a chapter cannot reopen it.
  createdAt  DateTime?  @default(now())
  responses  Response[]
  stats      BlockStats?
  aiInterviewSessions AiInterviewSession[]

  @@index([chapterId, order])
}

model Enrollment {
  id                String            @id @default(cuid())
  courseId          String
  course            Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId            String?
  user              User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  learnerProfileId  String?
  learnerProfile    LearnerProfile?   @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)
  organizationId    String?
  organization      Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  lifecycle         EnrollmentLifecycle @default(ACTIVE)
  source            EnrollmentSource  @default(DIRECT)
  externalMentorId  String?
  externalAssignmentId String?
  status            EnrollStatus      @default(ASSIGNED)
  assignedById      String?
  percentComplete   Int               @default(0)
  chaptersCompleted Int               @default(0)
  totalScore        Int               @default(0)
  maxScore          Int               @default(0)
  pendingReviews    Int               @default(0) // denormalized for reports — maintained at Response write/review time
  lastActiveAt      DateTime?
  lastNudgeSentAt   DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  variantSlug       String? // learner's variant in the course family; null = not picked yet
  variantChosenAt   DateTime?
  variantLockedAt   DateTime? // first chapter start fixes the learner's variant
  variantAssignedAt DateTime? // assignment at enrollment, never inferred from the current course setting
  releaseId         String?
  release           CourseRelease? @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  specialisationSlug     String? // follow-up track picked once the course is complete
  specialisationChosenAt DateTime?
  createdAt         DateTime          @default(now())
  chapterProgress   ChapterProgress[]
  dailyActivity     DailyActivity[]
  studySessions     StudySession[]
  integrityAttempts IntegrityAttempt[]
  payment           Payment?

  @@unique([courseId, userId])
  @@unique([courseId, learnerProfileId])
  @@unique([organizationId, source, externalAssignmentId])
  @@index([userId, status])
  @@index([learnerProfileId])
  @@index([organizationId, courseId])
}

model Organization {
  id              String                      @id @default(cuid())
  slug            String                      @unique
  name            String
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  apiCredentials  OrganizationApiCredential[]
  courseAllocations OrganizationCourse[]
  courseRequests  OrganizationCourseRequest[]
  enrollments     Enrollment[]
}

model OrganizationApiCredential {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accessKey      String       @unique
  secretHash     String
  label          String       @default("default")
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  lastUsedAt     DateTime?

  @@index([organizationId])
}

model OrganizationCourse {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  courseId           String
  course             Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  isAllowed          Boolean      @default(true)
  maxEnrollments     Int
  currentEnrollments Int          @default(0)
  expiresAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([organizationId, courseId])
  @@index([courseId])
}

model OrganizationCourseRequest {
  id             String                          @id @default(cuid())
  organizationId String
  organization   Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course                          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status         OrganizationCourseRequestStatus @default(PENDING)
  requestedAt    DateTime                        @default(now())
  reviewedAt     DateTime?
  reviewedById   String?
  reviewedBy     User?                           @relation("OrgCourseRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([courseId])
}

model Payment {
  id           String        @id @default(cuid())
  enrollmentId String        @unique
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  amountCents  Int
  currency     String        @default("USD")
  status       PaymentStatus @default(PENDING)
  provider     String?
  providerRef  String?
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

/// Denormalized daily study seconds — updated on heartbeat, not aggregated from Response.
model DailyActivity {
  id            String     @id @default(cuid())
  enrollmentId  String
  enrollment    Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  date          DateTime   @db.Date
  activeSeconds Int        @default(0)

  @@unique([enrollmentId, date])
  @@index([enrollmentId, date])
}

/// Estimated active seconds anywhere in the signed-in app, per user per UTC day. Study time is
/// already inside this number — never add DailyActivity on top. Pruned after the retention window
/// (services/activity/app-activity.ts); DailyActivity is not.
model AppActivityDay {
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  activeSeconds Int      @default(0)
  heartbeats    Int      @default(0)
  firstActiveAt DateTime
  lastActiveAt  DateTime

  @@id([userId, date])
  @@index([date])
}

/// One row per user. `lastActiveAt` is the end of the last credited app heartbeat: it bounds new
/// credit to wall-clock time across tabs and devices, and drives future inactivity reminders.
model UserAppActivity {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastActiveAt DateTime
  /// Client id of the last accepted heartbeat, so an exact retry is not counted twice.
  lastBeatId   String?

  @@index([lastActiveAt])
}

// --- Notifications — written only through services/notifications (see docs/12-notifications.mdx) --

/// One in-app notification for one user: the bell feed and its read state. `type`/`category` are
/// the strings in shared/api/notifications.ts.
model Notification {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  category  String
  title     String
  body      String        @db.Text
  /// App-relative link, e.g. /my-questions/abc.
  url       String?
  courseId  String?
  data      Json?
  /// Identity of the event, so a repeated event or a retried request never adds a second row.
  dedupeKey String
  readAt    DateTime?

  pushedAt  DateTime?
  createdAt DateTime      @default(now())
  emails    EmailOutbox[]

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([pushedAt, createdAt])
}

/// Channels a person switched off, by notification category. No row means everything is on.
model NotificationPreference {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailOptOut String[] @default([])
  inAppOptOut String[] @default([])
  updatedAt   DateTime @updatedAt
}

enum EmailOutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

/// Email waiting for (or done with) the background worker. Rendered when the event happens, sent
/// with retries and backoff, never from inside the API request that caused it.
model EmailOutbox {
  id             String            @id @default(cuid())
  /// Null for inboxes that are not accounts (ADMIN_NOTIFY_EMAIL).
  userId         String?
  user           User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationId String?
  notification   Notification?     @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  type           String
  category       String
  toEmail        String
  subject        String
  html           String            @db.Text
  text           String            @db.Text
  /// Event identity plus recipient; also sent to Resend as the idempotency key's scope.
  dedupeKey      String            @unique
  status         EmailOutboxStatus @default(PENDING)
  attempts       Int               @default(0)
  nextAttemptAt  DateTime          @default(now())
  /// Set while a worker owns the row; a stale lock is reclaimed after a few minutes.
  lockedAt       DateTime?
  lastError      String?           @db.Text
  providerId     String?
  sentAt         DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status, nextAttemptAt])
  @@index([userId])
}

/// One row per routine study reminder, whatever channel it used. Drives the reminder cadence and
/// the per-user daily limit; `slot` (UTC date + hour) makes a repeated job run a no-op.
model StudyReminderLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot      String
  courseIds String[]
  sentAt    DateTime @default(now())

  @@unique([userId, slot])
  @@index([userId, sentAt])
}

/// One explicit study sitting on a chapter. Heartbeats credit time only while RUNNING.
model StudySession {
  id            String             @id @default(cuid())
  enrollmentId  String
  enrollment    Enrollment         @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  chapterId     String
  chapter       Chapter            @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  status        StudySessionStatus @default(RUNNING)
  startedAt     DateTime           @default(now())
  endedAt       DateTime?
  activeSeconds Int                @default(0)
  updatedAt     DateTime           @updatedAt

  @@index([enrollmentId, startedAt])
  @@index([enrollmentId, status])
  @@index([chapterId])
}

model ChapterProgress {
  id               String         @id @default(cuid())
  enrollmentId     String
  enrollment       Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  chapterId        String
  chapter          Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  status           ProgressStatus @default(NOT_STARTED)
  blocksCompleted  Int            @default(0)
  blocksTotal      Int            @default(0)
  score            Int            @default(0)
  maxScore         Int            @default(0)
  timeSpentSeconds Int            @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  learningLog      Json? // { version, answers, checklist } — reflections + checklist ticks

  @@unique([enrollmentId, chapterId])
  @@index([chapterId, status])
}

model Response {
  id           String         @id @default(cuid())
  blockId      String
  block        Block          @relation(fields: [blockId], references: [id], onDelete: Cascade)
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollmentId String
  attempt      Int            @default(1)
  status       ResponseStatus @default(SUBMITTED)
  payload      Json // shape depends on block type — see docs/08-data-model.mdx
  score        Int?
  maxScore     Int?
  isCorrect    Boolean?
  durationMs   Int?
  startedAt    DateTime?
  submittedAt  DateTime       @default(now())
  review       Review?

  @@index([blockId, userId, attempt])
  @@index([enrollmentId])
  @@index([status]) // drives the review queue
}

model Review {
  id         String        @id @default(cuid())
  responseId String        @unique
  response   Response      @relation(fields: [responseId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User          @relation("Reviewer", fields: [reviewerId], references: [id])
  score      Int?
  feedback   String        @db.Text
  verdict    ReviewVerdict
  seenAt     DateTime?
  createdAt  DateTime      @default(now())
}

// Mentee help requests — separate from the open-question review queue (demo Day 3).
model HelpThread {
  id         String           @id @default(cuid())
  courseId   String
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapterId  String?
  chapter    Chapter?         @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  menteeId   String
  mentee     User             @relation("HelpThreadsAsked", fields: [menteeId], references: [id], onDelete: Cascade)
  status     HelpThreadStatus @default(OPEN)
  menteeLastReadAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  resolvedAt DateTime?
  messages   HelpMessage[]

  @@index([courseId, status, updatedAt])
  @@index([menteeId, updatedAt])
  @@index([chapterId, menteeId])
}

model HelpMessage {
  id        String     @id @default(cuid())
  threadId  String
  thread    HelpThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User       @relation("HelpMessagesAuthored", fields: [authorId], references: [id], onDelete: Cascade)
  body      String     @db.Text
  createdAt DateTime   @default(now())

  @@index([threadId, createdAt])
}

// Private margin notes on a chapter heading. Mentors do not read these.
model HeadingNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  headingId String
  body      String   @db.Text
  updatedAt DateTime @updatedAt

  @@unique([userId, chapterId, headingId])
  @@index([chapterId])
}

// Mentor -> mentee assignment surface (docs/phases/m7-assignment-and-polish.mdx).
// email set = email-bound invite (only that account can accept); email null =
// open invite link anyone signed in can accept. Acceptance creates an Enrollment.
model Invite {
  id           String    @id @default(cuid())
  token        String    @unique
  courseId     String
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  email        String?
  invitedById  String?
  invitedBy    User?     @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedAt   DateTime?
  acceptedById String?
  revokedAt    DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([courseId])
  @@index([email])
}

// Denormalized per-block aggregates, maintained in the same transaction as each
// Response write (recomputeChapterProgress) so reports never aggregate over
// Response on the read path — docs/06-reports.mdx.
model BlockStats {
  blockId         String    @id
  block           Block     @relation(fields: [blockId], references: [id], onDelete: Cascade)
  attempts        Int       @default(0)
  correctCount    Int       @default(0)
  pendingReviews  Int       @default(0)
  lastSubmittedAt DateTime?
}

// --- Quiz integrity signals ------------------------------------------------------------------
// Flags for mentors to judge, never an automatic verdict. Events are append-only rows (no
// read-modify-write log), each attempt has a hard cap, and camera stills are opt-in per course
// and deleted by the daily retention job after 30 days while the flags stay.

enum IntegrityEventType {
  TAB_HIDDEN
  WINDOW_BLUR
  FULLSCREEN_EXIT
  COPY_BLOCKED
  PASTE_BLOCKED
  CONTEXT_MENU_BLOCKED
  SCREENSHOT_KEY
  MOUSE_LEFT
  SECOND_SCREEN
  FAST_ANSWER
  CAMERA_OFF
  CAMERA_ON
}

enum IntegrityCameraStatus {
  NOT_REQUESTED
  ON
  DECLINED
  UNAVAILABLE
}

/// One proctored try at a quiz chapter. `attempt` is 1 + the learner's highest submitted
/// attempt in the chapter when the sitting opened, so reloads resume the same row.
model IntegrityAttempt {
  id            String                @id @default(cuid())
  enrollmentId  String
  enrollment    Enrollment            @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  chapterId     String
  chapter       Chapter               @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  attempt       Int
  cameraStatus  IntegrityCameraStatus @default(NOT_REQUESTED)
  eventCount    Int                   @default(0)
  droppedEvents Int                   @default(0)
  snapshotCount Int                   @default(0)
  startedAt     DateTime              @default(now())
  lastSeenAt    DateTime              @default(now())
  events        IntegrityEvent[]
  snapshots     IntegritySnapshot[]

  @@unique([enrollmentId, chapterId, attempt])
  @@index([chapterId])
}

model IntegrityEvent {
  id         String             @id @default(cuid())
  attemptId  String
  attempt    IntegrityAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  /// Browser-generated key, so a batch retried after a lost response is stored once.
  clientId   String             @db.VarChar(40)
  type       IntegrityEventType
  at         DateTime
  /// Question on screen when it happened, if known.
  blockId    String?
  meta       Json?
  receivedAt DateTime           @default(now())

  @@unique([attemptId, clientId])
  @@index([attemptId, at])
}

model IntegritySnapshot {
  id         String           @id @default(cuid())
  attemptId  String
  attempt    IntegrityAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  storageKey String           @unique
  bytes      Int
  takenAt    DateTime         @default(now())
  /// Set when the retention job deletes the image; the row stays as a record.
  deletedAt  DateTime?

  @@index([attemptId, takenAt])
  @@index([deletedAt, takenAt])
}

/// Append-only record of platform-admin actions, for accountability. The actor is
/// stored as a snapshot (id + email, no foreign key) so the trail survives user
/// deletion, and rows are never updated or removed by the application.
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String   @db.VarChar(320)
  /// Stable machine key, e.g. "organization.rotate-credential".
  action     String   @db.VarChar(64)
  /// "Organization" | "User" | "CourseRequest" | "InstructorAccessRequest".
  targetType String   @db.VarChar(40)
  targetId   String?  @db.VarChar(64)
  /// Human-readable one-liner shown in the admin audit view.
  summary    String   @db.VarChar(300)
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([actorId])
}
