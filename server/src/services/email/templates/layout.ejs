<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <style>
    p { margin: 0 0 18px; }
    a { color: #4338ca; text-decoration: underline; overflow-wrap: anywhere; }
    @media (max-width: 600px) { .content { padding: 28px 22px !important; } }
  </style>
</head>
<body style="margin:0;padding:0;background-color:#f4f5f8;color:#253047;font-family:Arial,Helvetica,sans-serif;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all;"><%= preheader %></div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f5f8;">
    <tr><td align="center" style="padding:32px 12px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:580px;">
        <tr><td style="padding:0 8px 22px;font-size:23px;font-weight:bold;letter-spacing:-0.6px;color:#172033;">Buildment<span style="color:#6366f1;">.</span></td></tr>
        <tr><td class="content" style="padding:36px;background-color:#ffffff;border:1px solid #e2e5ec;border-top:4px solid #4f46e5;border-radius:12px;font-size:16px;line-height:1.7;">
          <h1 style="margin:0 0 24px;font-size:24px;line-height:1.3;letter-spacing:-0.5px;color:#172033;"><%= title %></h1>
          <%- body %>
        </td></tr>
        <tr><td style="padding:22px 8px;font-size:12px;line-height:1.7;color:#667085;">
          Sent by <a href="<%= appUrl %>" style="color:#475467;">Buildment</a> for your account or course activity.
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
