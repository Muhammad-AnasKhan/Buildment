<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title><%= title %></title>
  <style>
    p { margin: 0 0 18px; }
    a { color: #2434e0; text-decoration: underline; overflow-wrap: anywhere; }
    @media (max-width: 600px) { .content { padding: 28px 22px !important; } }
  </style>
</head>
<body style="margin:0;padding:0;background-color:#f6f7fb;color:#0a0f2c;font-family:'DM Sans',Arial,Helvetica,sans-serif;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all;"><%= preheader %></div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f6f7fb;">
    <tr><td align="center" style="padding:32px 12px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;">
        <tr><td style="padding:0 4px 20px;">
          <a href="<%= appUrl %>" style="text-decoration:none;"><img src="<%= appUrl %>/brand/edorax-wordmark.png" width="149" height="30" alt="edorax" style="display:block;border:0;height:30px;width:149px;"></a>
        </td></tr>
        <tr><td class="content" style="padding:36px;background-color:#ffffff;border:1px solid #dce0f2;font-size:16px;line-height:1.6;">
          <h1 style="margin:0 0 20px;font-family:Unbounded,'DM Sans',Arial,Helvetica,sans-serif;font-size:24px;line-height:1.25;letter-spacing:-0.5px;color:#0a0f2c;"><%= title %></h1>
          <%- body %>
        </td></tr>
        <tr><td style="padding:20px 4px;font-size:12px;line-height:1.6;color:#46507a;">
          Sent by <a href="<%= appUrl %>" style="color:#46507a;">Edorax</a> for your account or course activity.
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
