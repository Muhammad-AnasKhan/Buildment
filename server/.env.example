# ── Runtime ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Postgres connection used by Prisma.
DATABASE_URL=postgresql://buildment:buildment@localhost:5432/buildment

# Public URL of the web app. Used for redirects (email confirmation, dev login)
# and for links inside emails.
APP_URL=http://localhost:3000

# Browser origins allowed to call the API directly (comma-separated). The Next.js
# proxy is same-origin and does not need this; desktop / third-party web clients do.
CORS_ORIGINS=http://localhost:3000

# ── Email (Resend). Leave empty locally: sends are logged, not delivered. ──────
AUTH_RESEND_KEY=
EMAIL_FROM="buildment <onboarding@resend.dev>"
# Extra inboxes notified for admin queue items, comma-separated.
ADMIN_NOTIFY_EMAIL=

# Bearer token an external scheduler must present to POST /api/v1/jobs/*.
CRON_SECRET=

# Local e2e runs sign up repeatedly from one IP; set to true only on a dev machine.
# Ignored when NODE_ENV=production.
DISABLE_RATE_LIMITS=false

# AI review drafts (optional). Without a key the draft button reports that drafting is not configured.
OPENROUTER_API_KEY=
OPENROUTER_REVIEW_MODEL=google/gemini-2.5-flash

# AI interviews: each learner brings their own OpenRouter key, stored encrypted with this
# server key. Generate one with `openssl rand -base64 32`. Leave empty to turn the feature off.
AI_KEY_ENCRYPTION_KEY=
# Default model a learner's interview uses until they pick another one.
OPENROUTER_INTERVIEW_MODEL=google/gemini-2.5-flash

# Private Cloudflare R2 storage for course images and quiz camera snapshots (under integrity/). Create an R2 S3 token scoped to this bucket.
# Use the account endpoint (without /buildment at the end). Keep credentials in server/.env only.
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=buildment
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Signs the short-lived snapshot links mentors open. Optional with one API process; set it
# (any long random string) when several replicas serve requests.
INTEGRITY_MEDIA_SECRET=

# Scheduled jobs run inside the API: study reminders every hour (each user at their own hour),
# cleanup daily at 00:00 UTC, and the daily jobs at the UTC hours below. Set JOBS_ENABLED=false
# when an external scheduler calls POST /api/v1/jobs/* with CRON_SECRET (study-reminders hourly),
# or on all but one replica.
JOBS_ENABLED=true
WEEKLY_GOAL_REMINDER_HOUR_UTC=9
# Deletes quiz camera snapshots older than 30 days (the flags stay).
INTEGRITY_RETENTION_HOUR_UTC=3

# ── Notifications (see docs/12-notifications.mdx) ─────────────────────────────
# Background worker that sends queued notification email (with retries) and pushes live
# notifications. Safe on every replica; turn off only where another process runs it.
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_MS=5000
# Most routine study reminders one user gets in 24 hours, across all their courses. 0 = off.
REMINDER_DAILY_LIMIT=1
# Signs the short-lived tickets that open the live notification stream (SSE). Optional with one
# API process; set the same random value on
# every replica when you run more than one (e.g. `openssl rand -hex 32`).
REALTIME_TOKEN_SECRET=

# ── Gamification (see docs/14-gamification.mdx) ───────────────────────────────
# Each feature is on unless set to false. Levels and leaderboards are built from XP, so they
# switch off with it.
GAMIFICATION_XP=true
GAMIFICATION_STREAK_FREEZES=true
GAMIFICATION_LEVELS=true
GAMIFICATION_LEADERBOARDS=true
