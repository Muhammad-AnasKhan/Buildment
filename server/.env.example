# ── Runtime ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Postgres connection used by Prisma.
DATABASE_URL=postgresql://buildment:buildment@localhost:5432/buildment

# Public URL of the web app. Used for redirects (email confirmation, dev login)
# and for links inside emails.
APP_URL=http://localhost:3000

# Browser origins allowed to call the API directly (comma-separated). The Next.js
# proxy is same-origin and does not need this; desktop / third-party web clients do.
CORS_ORIGINS=http://localhost:3000

# ── Email (Resend). Leave empty locally: sends are logged, not delivered. ──────
AUTH_RESEND_KEY=
EMAIL_FROM="buildment <onboarding@resend.dev>"
# Extra inboxes notified for admin queue items, comma-separated.
ADMIN_NOTIFY_EMAIL=

# Bearer token an external scheduler must present to POST /api/v1/jobs/*.
CRON_SECRET=

# Local e2e runs sign up repeatedly from one IP; set to true only on a dev machine.
# Ignored when NODE_ENV=production.
DISABLE_RATE_LIMITS=false

# AI review drafts (optional). Without a key the draft button reports that drafting is not configured.
OPENROUTER_API_KEY=
OPENROUTER_REVIEW_MODEL=google/gemini-2.5-flash

# Private Cloudflare R2 course image storage. Create an R2 S3 token scoped to this bucket.
# Use the account endpoint (without /buildment at the end). Keep credentials in server/.env only.
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=buildment
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Background jobs run inside the API once a day (UTC hour below). Set JOBS_ENABLED=false when an
# external scheduler calls POST /api/v1/jobs/* with CRON_SECRET, or on all but one replica.
JOBS_ENABLED=true
INACTIVITY_NUDGE_HOUR_UTC=9
WEEKLY_GOAL_REMINDER_HOUR_UTC=9
