# ── API ────────────────────────────────────────────────────────────────────────
# Where the Next.js server proxies /api/v1/* and /integrations/v1/*. Server-side only.
API_URL=http://localhost:4000
# Production (Vercel): API_URL=https://buildment-eca06ffd3e8f.herokuapp.com

# ── Auth ───────────────────────────────────────────────────────────────────────
# Sessions are issued by the API; the web app only stores the cookie. Nothing to
# configure here. Email delivery (verification, magic links) is set on the API.

# ── Optional integrations ──────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Public URL of this web app, shown in the integration docs.
APP_URL=http://localhost:3000
# Production (Vercel): APP_URL=https://buildment-dev.vercel.app
