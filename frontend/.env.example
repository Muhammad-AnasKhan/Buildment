# ── API ────────────────────────────────────────────────────────────────────────
# Where the Next.js server proxies /api/v1/* and /integrations/v1/*. Server-side only.
API_URL=http://localhost:4000

# ── Auth.js (until Phase 2 of docs/phases/backend-split.mdx) ───────────────────
AUTH_SECRET=            # pnpm dlx auth secret
AUTH_URL=http://localhost:3000
# Optional magic-link sign-in; the API owns transactional email otherwise.
AUTH_RESEND_KEY=
EMAIL_FROM="buildment <onboarding@resend.dev>"

# ── Transitional: pages that have not moved to the API yet still read Postgres ──
DATABASE_URL=postgresql://buildment:buildment@localhost:5432/buildment

# ── Optional integrations ──────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_REVIEW_MODEL=google/gemini-2.5-flash
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
