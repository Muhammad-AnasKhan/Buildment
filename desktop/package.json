{
  "name": "desktop",
  "productName": "Edorax",
  "version": "1.0.0",
  "private": true,
  "description": "Edorax desktop learning workspace",
  "keywords": [],
  "license": "MIT",
  "author": {
    "name": "ASIF RAZA",
    "email": "asifr.official9@gmail.com"
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/api.test.ts tests/labs.test.ts tests/local-runtime.test.ts tests/ide.test.ts",
    "test:ui": "playwright test",
    "dev:ui": "vite --config vite.renderer.config.mts --host 127.0.0.1 --port 5179 --strictPort",
    "test:labs": "tsx --test tests/labs.integration.test.ts",
    "test:ide": "tsx scripts/serve-ide-smoke.ts",
    "ide:setup": "npm --prefix ide run build && node scripts/prepare-pty.mjs",
    "ide:build": "npm --prefix ide run build",
    "postinstall": "node scripts/prepare-pty.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dockerode": "^4.0.2",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.0.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@buildment/learning-ui": "file:../packages/learning-ui",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dockerode": "^5.0.1",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^1.61.0",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "shiki": "^4.5.0",
    "unified": "^11.0.5"
  }
}
