{
  "name": "edorax-ide",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "theia build --mode production",
    "start": "theia start --hostname=127.0.0.1"
  },
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "Edorax Workspace",
        "defaultTheme": { "light": "light", "dark": "dark" },
        "defaultIconTheme": "theia-file-icons",
        "preferences": {
          "workbench.startupEditor": "none",
          "window.menuBarVisibility": "compact",
          "editor.minimap.enabled": false,
          "editor.fontSize": 13,
          "editor.lineHeight": 22,
          "editor.scrollBeyondLastLine": false
        }
      }
    }
  },
  "dependencies": {
    "@theia/core": "1.76.0",
    "@theia/editor": "1.76.0",
    "@theia/filesystem": "1.76.0",
    "@theia/file-search": "1.76.0",
    "@theia/markers": "1.76.0",
    "@theia/messages": "1.76.0",
    "@theia/monaco": "1.76.0",
    "@theia/navigator": "1.76.0",
    "@theia/preferences": "1.76.0",
    "@theia/process": "1.76.0",
    "@theia/terminal": "1.76.0",
    "@theia/workspace": "1.76.0",
    "@theia/search-in-workspace": "1.76.0",
    "@theia/toolbar": "1.76.0",
    "edorax-ide-extension": "file:./edorax-extension",
    "node": "24.8.0",
    "@theia/mini-browser": "1.76.0"
  },
  "devDependencies": {
    "@theia/cli": "1.76.0"
  }
}
